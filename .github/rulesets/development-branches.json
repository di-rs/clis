{
  "name": "Development branch names",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 29110,
      "actor_type": "Integration",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "~DEFAULT_BRANCH",
        "refs/heads/feat/**/*",
        "refs/heads/fix/**/*",
        "refs/heads/chore/**/*",
        "refs/heads/docs/**/*",
        "refs/heads/refactor/**/*"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    }
  ]
}
