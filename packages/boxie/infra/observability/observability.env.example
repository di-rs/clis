# Native defaults are in compose.yml; copy and set the installation-specific values.
BOXIE_ENVIRONMENT=production
BOXIE_HOST_ID=boxie-host
BOXIE_INSTALLATION_ID=
BOXIE_TEMPORAL_NAMESPACE=boxie
OBS_JOURNAL_GROUP_GID=
OBS_GRAFANA_HOSTNAME=grafana.example.com
OBS_GRAFANA_ADMIN_PASSWORD_FILE=/private/boxie/grafana-admin
OBS_GRAFANA_PLUGIN_DIR=/private/boxie/grafana-plugins
OBS_PROMETHEUS_CONFIG_FILE=/private/boxie/prometheus.yml
# The newest two daily VictoriaLogs partitions may exceed this cleanup target.
OBS_LOGS_DISK_BYTES=268435456
OBS_LOGS_RETENTION_DAYS=7
# Optional shared-network names; all three projects use the same defaults.
OBS_METRICS_NETWORK=boxie-metrics
OBS_GRAFANA_ORIGIN_NETWORK=boxie-grafana-origin
OBS_TEMPORAL_UI_ORIGIN_NETWORK=boxie-temporal-ui-origin
