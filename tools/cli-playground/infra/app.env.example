PLAYGROUND_DOMAIN=play.thesecret.dev
ACME_EMAIL=admin@example.com
# Generate with: openssl rand -hex 32
PLAYGROUND_DEPLOY_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
# Separate zone-scoped Zone:Read + DNS:Edit token, used only by Traefik renewal.
CLOUDFLARE_DNS_API_TOKEN=REPLACE_WITH_A_CLOUDFLARE_DNS_TOKEN

# Platform-owned private shared metrics bridge.
OBS_METRICS_NETWORK=boxie-metrics
