# Absolute paths refer to the Docker daemon's host. Keep real values outside Git.
BOXIE_PROJECT_NAME=boxie
BOXIE_RUNTIME_IMAGE=boxie:local
BOXIE_DATA_DIR=/var/lib/boxie
BOXIE_API_CONFIG=/etc/boxie/api.json
BOXIE_ORCHESTRATOR_CONFIG=/etc/boxie/orchestrator.json
BOXIE_PROFILES_FILE=/etc/boxie/profiles.json
BOXIE_ORCHESTRATOR_CREDENTIAL_FILE=/etc/boxie/orchestrator.secret
BOXIE_CONSUMER_CREDENTIAL_FILE=/etc/boxie/consumer.secret
BOXIE_CONSUMER_NETWORK=boxie-consumers
BOXIE_CONTROL_NETWORK=boxie-control
BOXIE_API_ALIAS=boxie-api
BOXIE_POSTGRES_DSN_FILE=/etc/boxie/postgres-dsn.secret
BOXIE_TEMPORAL_CA_FILE=/etc/temporal/certs/frontend-ca.pem
BOXIE_API_TEMPORAL_CERT_FILE=/etc/temporal/clients/boxie-api.pem
BOXIE_API_TEMPORAL_KEY_FILE=/etc/temporal/clients/boxie-api.key
BOXIE_ORCHESTRATOR_TEMPORAL_CERT_FILE=/etc/temporal/clients/boxie-orchestrator.pem
BOXIE_ORCHESTRATOR_TEMPORAL_KEY_FILE=/etc/temporal/clients/boxie-orchestrator.key

# Boxie-owned private observability bridges (create internal networks first).
OBS_METRICS_NETWORK=boxie-metrics
OBS_GRAFANA_ORIGIN_NETWORK=boxie-grafana-origin
OBS_TEMPORAL_UI_ORIGIN_NETWORK=boxie-temporal-ui-origin
BOXIE_ENVIRONMENT=local
BOXIE_RELEASE=unknown
