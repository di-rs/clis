# Render through ObservabilityConfig first. Never copy the test collector digest.
# Supply the separately published derived Linux amd64 image (repository@sha256:...).
OBS_COLLECTOR_IMAGE=
OBS_METRICS_NETWORK=boxie-metrics
OBS_GRAFANA_ORIGIN_NETWORK=boxie-grafana-origin
OBS_TEMPORAL_UI_ORIGIN_NETWORK=boxie-temporal-ui-origin
OBS_VECTOR_VOLUME=boxie-vector-data
OBS_LOGS_VOLUME=boxie-logs-data
OBS_PROMETHEUS_VOLUME=boxie-prometheus-data
OBS_GRAFANA_VOLUME=boxie-grafana-data
OBS_JOURNAL_DIRECTORY=/var/log/journal
OBS_MACHINE_ID_PATH=/etc/machine-id
# Set the actual host journal supplementary group, never assume a distro GID.
OBS_JOURNAL_GROUP_GID=
# Grafana owner materializes verified pinned plugin bytes and private credentials.
OBS_GRAFANA_PLUGIN_DIR=
OBS_GRAFANA_ADMIN_PASSWORD_FILE=
# Native log cleanup target; newest two daily partitions can exceed it.
OBS_LOGS_DISK_BYTES=268435456
OBS_LOGS_RETENTION_DAYS=7
# Hard Grafana RAM ceiling; renderer rejects larger budgets.
OBS_GRAFANA_MEMORY_BYTES=268435456
