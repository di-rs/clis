{
  "uid": "boxie-telemetry",
  "title": "Telemetry health",
  "description": "Scrape success is not application readiness. Unknown/missing is distinct from observed zero. Service, Vector and storage losses are separate populations; journald/Docker loss before Vector is unmeasured. Counters reset per process. Only configured consumers and backing mounts appear.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "boxie",
    "operators"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 101,
      "title": "Service log queue occupancy",
      "type": "stat",
      "description": "Records queued in each process. Does not measure downstream durability.",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "unit": "short",
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "(boxie_log_queue_occupancy{job=~\"boxie-api|boxie-orchestrator|boxie-orchestrator\"}) and on(job,instance) ((up{job=~\"boxie-api|boxie-orchestrator|boxie-orchestrator\"} == 1) and (time() - timestamp(up{job=~\"boxie-api|boxie-orchestrator|boxie-orchestrator\"}) < 45))",
          "range": false,
          "instant": true,
          "legendFormat": "{{job}} queue occupancy"
        }
      ]
    },
