    {
      "id": 105,
      "title": "Vector disk buffer bytes / maximum",
      "type": "stat",
      "description": "Serialized unread disk bytes, configured disk storage ceiling, and usable unread capacity after the pinned 128 MiB data-file reserve.",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported (possibly empty startup)",
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Not reported (possibly empty startup)",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Not reported (possibly empty startup)",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "(vector_buffer_size_bytes{job=\"vector\",component_id=\"storage\",buffer_id=\"storage\",buffer_type=\"disk\",stage=\"0\"}) and on(job,instance) ((up{job=~\"vector\"} == 1) and (time() - timestamp(up{job=~\"vector\"}) < 45))",
          "range": false,
          "instant": true,
          "legendFormat": "Actual buffer occupancy"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "(vector_buffer_max_size_bytes{job=\"vector\",component_id=\"storage\",buffer_id=\"storage\",buffer_type=\"disk\",stage=\"0\"}) and on(job,instance) ((up{job=~\"vector\"} == 1) and (time() - timestamp(up{job=~\"vector\"}) < 45))",
          "range": false,
          "instant": true,
          "legendFormat": "Configured buffer maximum"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "(((vector_buffer_max_size_bytes{job=\"vector\",component_id=\"storage\",buffer_id=\"storage\",buffer_type=\"disk\",stage=\"0\"} >= 268435488) - 134217728)) and on(job,instance) ((up{job=~\"vector\"} == 1) and (time() - timestamp(up{job=~\"vector\"}) < 45))",
          "range": false,
          "instant": true,
          "legendFormat": "Usable disk unread capacity"
        }
      ]
    },
    {
      "id": 106,
      "title": "Vector disk buffer utilization",
      "type": "stat",
      "description": "Disk unread bytes / (configured ceiling minus the pinned 128 MiB file reserve). Invalid or absent capacity is unknown.",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Not reported (possibly empty startup)",
          "unit": "percent",
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Not reported (possibly empty startup)",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Not reported (possibly empty startup)",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "(100 * vector_buffer_size_bytes{job=\"vector\",component_id=\"storage\",buffer_id=\"storage\",buffer_type=\"disk\",stage=\"0\"} / ((vector_buffer_max_size_bytes{job=\"vector\",component_id=\"storage\",buffer_id=\"storage\",buffer_type=\"disk\",stage=\"0\"} >= 268435488) - 134217728)) and on(job,instance) ((up{job=~\"vector\"} == 1) and (time() - timestamp(up{job=~\"vector\"}) < 45))",
          "range": false,
          "instant": true,
          "legendFormat": "Buffer used"
        }
      ]
    },
