{
  "uid": "boxie-operations",
  "title": "Boxie operations",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "request_id",
        "label": "request id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "sandbox_id",
        "label": "sandbox id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Lifecycle states",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boxie_sandboxes",
          "legendFormat": "{{__name__}} {{state}} {{outcome}} {{dependency}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Reserved capacity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boxie_capacity_reserved or boxie_capacity_limit",
          "legendFormat": "{{__name__}} {{state}} {{outcome}} {{dependency}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Provisioning outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(outcome) (rate(boxie_provisioning_total[5m]))",
          "legendFormat": "{{__name__}} {{state}} {{outcome}} {{dependency}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Provisioning readiness p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(boxie_provisioning_ready_observation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{__name__}} {{state}} {{outcome}} {{dependency}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cleanup and unknown ages",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boxie_cleanup_pending or boxie_cleanup_oldest_age_seconds or boxie_cleanup_age_unknown",
          "legendFormat": "{{__name__}} {{state}} {{outcome}} {{dependency}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Workers and dependencies",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boxie_dependency_ready or boxie_dependency_known",
          "legendFormat": "{{__name__}} {{state}} {{outcome}} {{dependency}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Control leases",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boxie_orchestrator_control_lease_remaining_seconds",
          "legendFormat": "{{__name__}} {{state}} {{outcome}} {{dependency}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Telemetry health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "boxie_log_dropped_total or boxie_log_sink_available or boxie_snapshot_fresh",
          "legendFormat": "{{__name__}} {{state}} {{outcome}} {{dependency}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Disk headroom",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes / node_filesystem_size_bytes",
          "legendFormat": "{{__name__}} {{state}} {{outcome}} {{dependency}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Alerts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{__name__}} {{state}} {{outcome}} {{dependency}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Correlated lifecycle logs (ID regex; empty matches all)",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "boxie-victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:=\"boxie\" AND request_id:~\"${request_id:raw}\" AND sandbox_id:~\"${sandbox_id:raw}\"",
          "queryType": "instant"
        }
      ]
    }
  ]
}
