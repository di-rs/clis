# Nonsecret configuration fixture ONLY. This collector digest is deliberately
# synthetic; it cannot activate a deployment and is never claimed as published.
OBS_COLLECTOR_IMAGE=registry.example.invalid/collector@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
OBS_METRICS_NETWORK=fixture-metrics
OBS_GRAFANA_ORIGIN_NETWORK=fixture-grafana
OBS_TEMPORAL_UI_ORIGIN_NETWORK=fixture-temporal-ui
OBS_VECTOR_VOLUME=fixture-vector
OBS_LOGS_VOLUME=fixture-logs
OBS_PROMETHEUS_VOLUME=fixture-prometheus
OBS_GRAFANA_VOLUME=fixture-grafana-data
OBS_JOURNAL_GROUP_GID=987
OBS_JOURNAL_DIRECTORY=/var/log/journal
OBS_MACHINE_ID_PATH=/etc/machine-id
OBS_GRAFANA_PROVISIONING_DIR=/fixture/grafana/provisioning
OBS_GRAFANA_PLUGIN_DIR=/fixture/grafana/plugins
OBS_GRAFANA_ADMIN_PASSWORD_FILE=/fixture/grafana-admin
