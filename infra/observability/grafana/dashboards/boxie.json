    {
      "id": 21,
      "title": "Provisioning producer scrapes: API / worker",
      "type": "stat",
      "description": "Both producers must be scraping for complete process-local provisioning aggregates. Unknown/missing or failed scrape means the outcome and latency views may be partial. Scraping is not application readiness.",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Unknown / missing",
                  "color": "gray"
                },
                "0": {
                  "text": "Scrape failed",
                  "color": "red"
                },
                "1": {
                  "text": "Scraping",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "(up{job=\"boxie-api\"} and (time() - timestamp(up{job=\"boxie-api\"}) < 45)) or on() vector(-1)",
          "instant": true,
          "range": false,
          "legendFormat": "API"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "(up{job=\"boxie-worker\"} and (time() - timestamp(up{job=\"boxie-worker\"}) < 45)) or on() vector(-1)",
          "instant": true,
          "range": false,
          "legendFormat": "worker"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
