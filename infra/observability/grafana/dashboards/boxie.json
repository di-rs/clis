{
  "uid": "boxie-operations",
  "title": "Boxie operations",
  "description": "SQL gauges are authoritative only while snapshot and scrape are fresh. Process counters can lose crash-window observations. Unknown is not zero. Correlation IDs are observed dropdown values; no free-form paste support.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "boxie",
    "operators"
  ],
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "SQL snapshot health and age",
      "type": "stat",
      "description": "Initialized/fresh/latest refresh are separate 0/1 evidence. Age is seconds; missing before first successful sample. Values disappear from current panels after 45s without successful scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "unit": "short",
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "(boxie_snapshot_initialized{job=\"boxie-api\"}) and on(job,instance) ((up{job=~\"boxie-api\"} == 1) and (time() - timestamp(up{job=~\"boxie-api\"}) < 45))",
          "range": false,
          "instant": true,
          "legendFormat": "Initialized"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "(boxie_snapshot_fresh{job=\"boxie-api\"}) and on(job,instance) ((up{job=~\"boxie-api\"} == 1) and (time() - timestamp(up{job=~\"boxie-api\"}) < 45))",
          "range": false,
          "instant": true,
          "legendFormat": "Fresh"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "(boxie_snapshot_refresh_success{job=\"boxie-api\"}) and on(job,instance) ((up{job=~\"boxie-api\"} == 1) and (time() - timestamp(up{job=~\"boxie-api\"}) < 45))",
          "range": false,
          "instant": true,
          "legendFormat": "Last refresh succeeded"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "(boxie_snapshot_age_seconds{job=\"boxie-api\"}) and on(job,instance) ((up{job=~\"boxie-api\"} == 1) and (time() - timestamp(up{job=~\"boxie-api\"}) < 45))",
          "range": false,
          "instant": true,
          "legendFormat": "Snapshot age (seconds)"
        }
      ]
    },
    {
      "id": 2,
      "title": "SQL capacity: reserved / limit",
      "type": "stat",
      "description": "SQL reservations and available slots. A limit of zero is no capacity, not an undefined success.",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "unit": "short",
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "((boxie_capacity_reserved{job=\"boxie-api\"}) and on(job,instance) (boxie_snapshot_fresh{job=\"boxie-api\"} == 1)) and on(job,instance) ((up{job=~\"boxie-api\"} == 1) and (time() - timestamp(up{job=~\"boxie-api\"}) < 45))",
          "range": false,
          "instant": true,
          "legendFormat": "Reserved slots"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "((boxie_capacity_limit{job=\"boxie-api\"}) and on(job,instance) (boxie_snapshot_fresh{job=\"boxie-api\"} == 1)) and on(job,instance) ((up{job=~\"boxie-api\"} == 1) and (time() - timestamp(up{job=~\"boxie-api\"}) < 45))",
          "range": false,
          "instant": true,
          "legendFormat": "Configured slot limit"
        }
      ]
    },
    {
      "id": 3,
      "title": "SQL capacity utilization",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "unit": "percent",
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "boxie-prometheus"
          },
          "editorMode": "code",
          "expr": "((100 * boxie_capacity_reserved{job=\"boxie-api\"} / (boxie_capacity_limit{job=\"boxie-api\"} > 0)) and on(job,instance) (boxie_snapshot_fresh{job=\"boxie-api\"} == 1)) and on(job,instance) ((up{job=~\"boxie-api\"} == 1) and (time() - timestamp(up{job=~\"boxie-api\"}) < 45))",
          "range": false,
          "instant": true,
          "legendFormat": "Reserved capacity"
        }
      ]
    },
