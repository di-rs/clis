    {
      "id": 9,
      "title": "Observed provisioning outcomes, last 5m",
      "type": "stat",
      "description": "Process-local estimates, not a ledger. Missing API/worker scrape makes this partial; see Telemetry health. Failures count only after confirmed removal.",
      "datasource": {
        "type": "prometheus",
        "uid": "boxie-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
