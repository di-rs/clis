[Unit]
Description=CLIs setup operation %i
Requires=docker.service
After=docker.service
RequiresMountsFor=/srv/clis

[Service]
Type=oneshot
TimeoutStartSec=900
KillMode=control-group
RemainAfterExit=yes
UMask=0077
ExecStartPre=/usr/local/sbin/clis-storage-guard
ExecStart=/usr/bin/flock -n /run/lock/clis-deployment.lock /bin/bash /usr/local/sbin/clis-operation setup %i
